{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "pnpm": "10.34.5"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "pnpm": "10.34.5"
    },
    "preview": {
      "environment": "production",
      "distribution": "internal",
      "developmentClient": false,
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "apk"
      },
      "pnpm": "10.34.5"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6799745470"
      }
    }
  }
}
