{
  "name": "mobile",
  "version": "1.0.1",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.112.0",
    "expo": "~57.0.10",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.6",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "57.0.13",
    "expo-dev-client": "~57.0.10",
    "expo-linking": "~57.0.5",
    "expo-notifications": "57.0.13",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "start:preview": "APP_VARIANT=preview expo start --dev-client",
    "start:clear": "APP_VARIANT=development expo start --dev-client --clear",
    "start:tunnel": "APP_VARIANT=development expo start --dev-client --clear --tunnel",
    "android": "APP_VARIANT=development expo start --dev-client --android",
    "ios": "APP_VARIANT=development expo start --dev-client --ios",
    "web": "expo start --web",
    "build:ios:production": "pnpm dlx eas-cli@latest build --platform ios --profile production --auto-submit"
  },
  "private": true
